{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["pnku"],
  "contact": {
    "homepage": "https://www.pnku.de",
    "email": "contact@pnku.de",
    "sources": "https://github.com/pnk2u/More-Frame-Variants",
    "issues": "https://github.com/pnk2u/More-Frame-Variants/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "accessWidener": "mstv-mframev.accesswidener",
  "entrypoints": {
    "main": [
      "de.pnku.mstv_mframev.MoreFrameVariants"
    ],
    "client": [
      "de.pnku.mstv_mframev.MoreFrameVariantsClient"
    ]
  },
  "accessWidener": "mstv-mframev.accesswidener",
  "mixins": [
    "mstv-mframev.mixins.json" ,
    {
			"config": "mstv-mframev.client.mixins.json" ,
			"environment": "client"
    },
    "mstv-mframev.compat.fastitemframes.mixins.json",
    {
            "config": "mstv-mframev.compat.fastitemframes.client.mixins.json" ,
            "environment": "client"
    }
  ],
  "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": ">=${minecraft_version_0} <${minecraft_version_1}",
		"java": ">=${java_version}",
		"fabric-api": "*",
        "mstv-base": ">=${mstv_version}"
	},
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.lieonlion.dev"
      }
    },
    "mc-publish": {
      "modrinth": "vwp1lXf8",
      "curseforge": "1120946",
      "dependencies": [
        "fabric-api(required)#(ignore)",
        "mstv-base(required){modrinth:ZVv4e6pP}{curseforge:1096913}"
      ]
    }
  }
}
